@using System
@using System.Linq
@model IEnumerable<Course>

@{
    ViewData["Title"] = "Dersler";
    var courses = Model?.ToList() ?? new List<Course>();
    var total = courses.Count;
}

<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <h6 class="card-subtitle mb-1">Toplam Ders</h6>
                        <h3 class="card-title mb-0">@total</h3>
                    </div>
                    <div class="ms-auto">
                        <a asp-action="Create" class="btn btn-light btn-sm">Yeni Ders Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (!courses.Any()) {
            <div class="col">
                <div class="alert alert-info">Herhangi bir ders bulunamadı.</div>
            </div>
        } else {
            foreach (var item in courses) {
                var percent = 0;
                if (item.MaxAbsence > 0) {
                    percent = (int)Math.Round((double)item.AbsenteeismCount / item.MaxAbsence * 100);
                    if (percent < 0) percent = 0;
                    if (percent > 100) percent = 100;
                }
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div>
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text text-muted mb-2">Öğretmen: @item.Lecturer</p>
                            </div>

                            <div class="mt-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Devamsızlık: @item.AbsenteeismCount / @item.MaxAbsence</small>
                                    <small class="fw-semibold">@percent%</small>
                                </div>
                                <div class="progress" style="height:10px;">
                                    <div class="progress-bar @(percent >= 80 ? "bg-danger" : (percent >= 50 ? "bg-warning" : "bg-success"))" role="progressbar" style="width:@percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <div class="mt-auto pt-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-2">Düzenle</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm me-2">Detay</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Sil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
