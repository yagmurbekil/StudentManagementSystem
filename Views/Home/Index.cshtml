@{
    ViewData["Title"] = "Giriş";
}

<style>
    body {
        background: linear-gradient(135deg, #f8fafc 0%, #e3e9f7 100%);
        min-height: 100vh;
    }
    .hero-section {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hero-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 4px 32px rgba(0,0,0,0.08);
        padding: 3rem 2.5rem;
        max-width: 480px;
        width: 100%;
        text-align: center;
    }
    .hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #1a237e;
        margin-bottom: 1.5rem;
    }
    .hero-btn {
        font-size: 1.25rem;
        padding: 0.85rem 2.5rem;
        border-radius: 2rem;
        font-weight: 600;
        box-shadow: 0 2px 8px rgba(26,35,126,0.08);
        transition: background 0.2s, color 0.2s;
    }
    .hero-btn:hover {
        background: #283593;
        color: #fff;
    }
</style>

<div class="hero-section">
    <div class="hero-card">
        <h1 class="hero-title mb-4">Samsun Üniversitesi Öğrenci Paneli</h1>
        <a href="/Courses" class="btn btn-primary hero-btn mb-2">Derslerimi ve Ödevlerimi Yönet</a>
    </div>
</div>

